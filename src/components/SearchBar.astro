---
interface Props {
  projectId: string
  placeholder?: string
}

const { projectId, placeholder = 'Search events...' } = Astro.props
---

<div class='search-bar' x-data="{ query: '', active: false }">
  <div class='search-wrapper' :class='{ active }'>
    <svg
      class='search-icon'
      width='16'
      height='16'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2.5'
      stroke-linecap='round'
      stroke-linejoin='round'>
      <circle cx='11' cy='11' r='8'></circle>
      <line x1='21' y1='21' x2='16.65' y2='16.65'></line>
    </svg>
    <input
      type='text'
      x-model='query'
      @focus='active = true'
      @blur='if (!query) active = false'
      name='search'
      placeholder={placeholder}
      hx-get={`/partials/event-list?project=${projectId}`}
      hx-trigger='input changed delay:300ms, search'
      hx-target='#event-list'
      hx-include='this'
    />
    <button
      x-show='query.length > 0'
      @click="query = ''; $el.closest('.search-wrapper').querySelector('input').dispatchEvent(new Event('search'))"
      class='search-clear'
      x-cloak>
      <svg
        width='16'
        height='16'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'>
        <line x1='18' y1='6' x2='6' y2='18'></line>
        <line x1='6' y1='6' x2='18' y2='18'></line>
      </svg>
    </button>
  </div>
</div>

<style>
  .search-bar {
    margin-bottom: 8px;
  }

  .search-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 10px 18px;
    transition: all 0.15s;
  }
  .search-wrapper.active {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.1);
  }

  .search-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-size: 14px;
    color: var(--color-text);
  }
  input::placeholder {
    color: var(--color-text-muted);
  }

  .search-clear {
    background: none;
    border: none;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    padding: 0;
    transition: color 0.15s;
  }
  .search-clear:hover {
    color: var(--color-text);
  }
</style>

---
interface Props {
  event: {
    id: number
    icon: string | null
    title: string
    description: string | null
    category: string
    tags: string | null
    url: string | null
    notify: boolean
    favorited: boolean
    createdAt: Date
  }
  projectName?: string
}

const { event, projectName } = Astro.props

function formatTime(date: Date): string {
  const now = new Date()
  const diff = now.getTime() - date.getTime()
  const mins = Math.floor(diff / 60000)
  const hours = Math.floor(mins / 60)
  const days = Math.floor(hours / 24)

  const timeStr = date
    .toLocaleTimeString('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    })
    .toLowerCase()

  if (days === 0) return `today at ${timeStr}`
  if (days === 1) return `yesterday at ${timeStr}`
  const dayName = date
    .toLocaleDateString('en-US', { weekday: 'long' })
    .toLowerCase()
  if (days < 7) return `${dayName} at ${timeStr}`
  return (
    date
      .toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
      .toLowerCase() + ` at ${timeStr}`
  )
}

function formatTimeCompact(date: Date): string {
  const now = new Date()
  const diff = now.getTime() - date.getTime()
  const days = Math.floor(diff / 86400000)

  const hour = date.getHours() % 12 || 12
  const minute = date.getMinutes().toString().padStart(2, '0')
  const ampm = date.getHours() < 12 ? 'am' : 'pm'
  const timeStr = `${hour.toString().padStart(2, '0')}:${minute} ${ampm}`

  if (days === 0) return `today ${timeStr}`
  if (days === 1) return `yest. ${timeStr}`
  return (
    date
      .toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
      .toLowerCase() + ` ${timeStr}`
  )
}

function formatDescription(desc: string): string {
  return desc
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2">$1</a>')
}

let parsedTags: Record<string, string> = {}
if (event.tags) {
  try {
    parsedTags = JSON.parse(event.tags)
  } catch {}
}
const tagEntries = Object.entries(parsedTags)

const categoryColors = [
  '#4338ca',
  '#059669',
  '#e84855',
  '#f59e0b',
  '#7c3aed',
  '#0891b2',
  '#ea580c',
  '#d946ef',
  '#2563eb',
  '#16a34a',
]

function getCategoryColor(name: string): string {
  let hash = 0
  for (let i = 0; i < name.length; i++) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash)
  }
  return categoryColors[Math.abs(hash) % categoryColors.length]
}
---

<div
  class:list={['event-row', { 'event-notify': event.notify }]}
  data-event-id={event.id}
  {...event.notify
    ? {
        'data-notify': '',
        'data-notify-title': event.title,
        'data-notify-category': event.category,
        'data-notify-icon': event.icon || '📌',
      }
    : {}}
  x-data={`{ fav: ${event.favorited}, deleting: false }`}>
  <time class='event-time-col'>{formatTimeCompact(event.createdAt)}</time>
  <div class='event-icon'>{event.icon || '📌'}</div>
  <div class='event-body'>
    <h3 class='event-title'>
      {
        event.url ? (
          <a
            href={event.url}
            target='_blank'
            rel='noopener noreferrer'
            class='event-link'>
            {event.title}
            <svg
              class='link-icon'
              width='11'
              height='11'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              stroke-linecap='round'
              stroke-linejoin='round'>
              <path d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6' />
              <polyline points='15 3 21 3 21 9' />
              <line x1='10' y1='14' x2='21' y2='3' />
            </svg>
          </a>
        ) : (
          event.title
        )
      }
      {
        event.notify && (
          <span class='notify-indicator' title='Notification'>
            <svg
              width='12'
              height='12'
              viewBox='0 0 24 24'
              fill='#6366f1'
              stroke='none'>
              <path d='M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9' />
              <path d='M13.73 21a2 2 0 0 1-3.46 0' />
            </svg>
          </span>
        )
      }
      <span class='fav-indicator' x-show='fav' x-cloak>
        <svg
          width='12'
          height='12'
          viewBox='0 0 24 24'
          fill='#f59e0b'
          stroke='none'>
          <polygon
            points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'
          ></polygon>
        </svg>
      </span>
    </h3>
    {
      event.description && (
        <p
          class='event-description'
          set:html={formatDescription(event.description)}
        />
      )
    }
    {
      tagEntries.length > 0 && (
        <div class='event-tags'>
          {tagEntries.map(([key, value]) => (
            <span class='tag-pill'>
              <span class='tag-key'>{key}</span>
              <span class='tag-value'>{value}</span>
            </span>
          ))}
        </div>
      )
    }
    <div class='event-meta'>
      <span class='event-category'>
        <span
          class='category-dot'
          style={`background: ${getCategoryColor(event.category)}`}></span>
        {event.category}
      </span>
      <span class='event-dot'>&middot;</span>
      <time class='event-time'>{formatTime(event.createdAt)}</time>
    </div>
  </div>
  <div class='event-actions'>
    <button
      class='action-btn'
      :class="{ 'is-fav': fav }"
      title='Favorite'
      @click={`
        fetch('/api/events/${event.id}/favorite', { method: 'POST' })
          .then(r => r.json())
          .then(d => {
            const was = fav;
            fav = d.favorited;
            if (fav !== was) $dispatch('favorite-changed', { delta: fav ? 1 : -1 });
          })
      `}>
      <svg
        width='15'
        height='15'
        viewBox='0 0 24 24'
        :fill="fav ? '#f59e0b' : 'none'"
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'>
        <polygon
          points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'
        ></polygon>
      </svg>
    </button>
    <button
      class='action-btn action-delete'
      title='Delete'
      @click={`
        if (!confirm('Delete this event?')) return;
        deleting = true;
        fetch('/api/events/${event.id}/delete', { method: 'POST' })
          .then(r => { if (r.ok) $el.closest('.event-row').remove() })
      `}>
      <svg
        width='15'
        height='15'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'>
        <polyline points='3 6 5 6 21 6'></polyline>
        <path
          d='M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2'
        ></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .event-time-col {
    display: none;
  }

  .event-row {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 14px 12px;
    margin: 0 -12px;
    border-radius: var(--radius-md);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    transition: background 0.12s;
  }
  .event-row:last-child {
    border-bottom: none;
  }
  .event-row:hover {
    background: rgba(67, 56, 202, 0.03);
  }

  .event-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .event-body {
    flex: 1;
    min-width: 0;
  }

  .event-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.35;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
  }

  .event-link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.12s;
  }
  .event-link:hover {
    color: var(--color-primary);
  }
  .link-icon {
    opacity: 0.4;
    flex-shrink: 0;
    transition: opacity 0.12s;
  }
  .event-link:hover .link-icon {
    opacity: 1;
  }

  .event-notify {
    border-left: 3px solid #6366f1;
    padding-left: 9px;
  }

  .notify-indicator {
    display: inline-flex;
    flex-shrink: 0;
  }

  .fav-indicator {
    display: inline-flex;
    flex-shrink: 0;
  }

  .event-description {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-top: 3px;
    line-height: 1.5;
  }
  .event-description :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }
  .event-description :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(67, 56, 202, 0.3);
  }

  .event-tags {
    display: none;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 6px;
  }

  .tag-pill {
    display: inline-flex;
    font-size: 11px;
    line-height: 1;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .tag-key {
    padding: 3px 5px;
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .tag-value {
    padding: 3px 6px;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-muted);
    margin-top: 6px;
  }

  .event-category {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .category-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .event-dot {
    color: var(--color-border);
  }

  .event-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.12s;
  }
  .event-row:hover .event-actions {
    opacity: 1;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: none;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    transition: all 0.12s;
  }
  .action-btn:hover {
    background: var(--color-bg);
    color: var(--color-text);
  }
  .action-btn.is-fav {
    color: #f59e0b;
  }
  .action-btn.is-fav:hover {
    background: #fef3c7;
  }

  .action-delete:hover {
    color: var(--color-danger);
    background: var(--color-danger-light);
  }

  @media (max-width: 768px) {
    .event-row {
      margin: 0;
      padding: 14px 0;
    }
  }
</style>

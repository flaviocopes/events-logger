---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import InsightCard from '@/components/InsightCard.astro'
import { db } from '@/db'
import { insights } from '@/db/schema'
import { eq, desc } from 'drizzle-orm'

const { id } = Astro.params

const projectInsights = db
  .select()
  .from(insights)
  .where(eq(insights.projectId, id!))
  .orderBy(desc(insights.updatedAt))
  .all()
---

<DashboardLayout projectId={id!} currentPage='insight'>
  <div class='insight-header'>
    <h1>Insights</h1>
  </div>

  <div
    id='insight-grid'
    hx-get={`/partials/insight-grid?project=${id}`}
    hx-trigger='every 15s'
    hx-swap='innerHTML'>
    {
      projectInsights.length > 0 && (
        <div class='insight-count-row'>
          <span class='insight-count'>{projectInsights.length} metric{projectInsights.length !== 1 ? 's' : ''}</span>
        </div>
      )
    }
    {
      projectInsights.length === 0 ? (
        <div class='empty-insight'>
          <p class='empty-main'>No insights yet!</p>
          <p class='empty-sub'>Push insight data via the API or CLI.</p>
        </div>
      ) : (
        <div class='insight-grid'>
          {projectInsights.map(insight => (
            <InsightCard insight={insight} projectId={id!} />
          ))}
        </div>
      )
    }
  </div>
</DashboardLayout>

<style>
  .insight-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  .insight-header h1 {
    font-size: 28px;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.03em;
  }

  .insight-count-row {
    margin-bottom: 16px;
  }
  .insight-count {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .insight-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .empty-insight {
    text-align: center;
    padding: 80px 20px;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
  }
  .empty-main {
    font-size: 20px;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 6px;
  }
  .empty-sub {
    color: var(--color-text-secondary);
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .insight-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
